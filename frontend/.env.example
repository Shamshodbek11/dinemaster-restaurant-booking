# Nusxa oling: cp .env.example .env
#
# Development'da (npm run dev) bu qiymat SHART EMAS: Vite /api so'rovlarini http://localhost:5000 ga
# o'zi uzatadi (vite.config.ts → server.proxy), sayt telefondan ochilganda ham ishlaydi.
# Faqat production build uchun yoki backend boshqa manzilda bo'lsa yoqing:
# VITE_API_BASE_URL=https://api.dinemaster.uz

# Dastur nomi (sarlavha, logotip, matnlar). Backend'da ham: appsettings.json -> Branding:Name
# VITE_BRAND_NAME=DineMaster

# Qo'llab-quvvatlash emaili (Foydalanish shartlari / Maxfiylik sahifalarida ko'rsatiladi)
# VITE_SUPPORT_EMAIL=support@example.uz
